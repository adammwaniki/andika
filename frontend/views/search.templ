package views

templ SearchBar() {
    <div class="flex-1 flex flex-col mx-6 shadow-2xl relative bg-[#EFF6F6] 
                outline-solid outline-[#FFC727] outline-2 outline-offset-4 
                hover:outline-[#FFC727] rounded-2xl py-2 px-4 my-2">
        //HTMX search form: replaces #notes-grid with results -->
        <form 
            id="search-form"
            hx-get="/api/notes/search"
            hx-target="#notes-grid"
            hx-swap="innerHTML"
            class="flex items-center w-full gap-2 
                   focus-within:outline-2 focus-within:outline-[#d9d9d9] 
                   hover:outline-[#d9d9d9] hover:outline">
            
            <input 
                id="searchBar"
                name="q"
                class="w-full outline-none font-normal text-base scrollbarHide pr-2"
                placeholder="Search notes..."
                autocomplete="off"
                hx-trigger="keyup changed delay:300ms"
            />

            <button type="submit" class="searchBtn cursor-pointer" aria-label="Search">
                <i class="fa-solid fa-magnifying-glass fa-xl text-gray-400"></i>
            </button>
        </form>
    </div>
}
